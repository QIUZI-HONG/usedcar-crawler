# ===== 环境变量模板：复制为 .env 后按需修改 =====
# 优先级：环境变量 > .env > config/settings.yaml > 代码默认值
# 仓库内不得提交任何真实凭据。

# --- 存储 ---
# 默认 SQLite（零依赖，开箱即用）；生产切换 MySQL
UCC_DATABASE__URL=sqlite:///./data/usedcar.db
# UCC_DATABASE__URL=mysql+pymysql://user:password@127.0.0.1:3306/usedcar?charset=utf8mb4

# --- 日志 ---
UCC_LOGGING__LEVEL=INFO
UCC_LOGGING__JSON_LINES=false

# --- 采集限速（对目标站点保持礼貌，勿调高） ---
UCC_FETCH__DEFAULT_QPS=0.5
UCC_FETCH__REQUEST_TIMEOUT=30

# --- 代理（可选，留空则不使用） ---
UCC_FETCH__PROXY=

# --- 通知 Webhook（可选，用于改版/失败告警） ---
UCC_NOTIFY__WEBHOOK_URL=
